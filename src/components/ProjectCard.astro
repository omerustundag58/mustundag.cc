---
import type { Project } from '../data/projects';
import { formatDate } from '../utils/date';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class:list={['proj', p.featured && 'proj--feat']}>
  <div class="proj__head">
    <a class="proj__name" href={p.url} rel="noopener">{p.name}</a>
    {p.featured && <span class="badge">öne çıkan</span>}
    {p.archived && <span class="badge badge--amber">arşiv</span>}
    <span class="proj__stars" title="yıldız">★ {p.stars}</span>
  </div>

  <p class="proj__desc">{p.desc}</p>

  <div class="proj__meta">
    {p.lang && <span class="lang">{p.lang}</span>}
    <span class="updated">son commit: {formatDate(new Date(p.updatedAt))}</span>
    <span class="links">
      {p.site && <a href={p.site} rel="noopener">site ↗</a>}
      <a href={p.url} rel="noopener">kod ↗</a>
    </span>
  </div>

  {
    p.topics.length > 0 && (
      <div class="tags">
        {p.topics.slice(0, 6).map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</article>
