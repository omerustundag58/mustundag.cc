---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Prompt from '../components/Prompt.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { getFeaturedProjects } from '../data/projects';
import { getCollection } from 'astro:content';

const projects = await getFeaturedProjects(4);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const description =
  'Ömer Üstündağ — ağ ve yazılım. sansürü delen DPI VPN, açık kaynak araçlar ve notlar.';
---

<Base description={description}>
  <!-- ===== hero ===== -->
  <Terminal title="omer@mustundag: ~ — bash">
    <Prompt cmd="whoami" delay={0.15}>
      <p class="hero__tag">// ağ &amp; yazılım</p>
      <h1 class="hero__name">Ömer Üstündağ</h1>
      <p class="hero__tag">
        Sansürü delen <strong>DPI VPN</strong>'in yapımcısı. Ağ, sistem ve
        açık kaynak tarafında çalışıyorum.
      </p>
      <p class="hero__sub">Rust · Python · TypeScript · Kotlin &nbsp;|&nbsp; Ankara → internet</p>

      <div class="btn-row">
        <a class="btn" href="https://github.com/omerustundag58">→ github</a>
        <a class="btn" href="https://vpn.mustundag.cc">→ dpi vpn</a>
        <a class="btn btn--ghost" href="mailto:omer@mustundag.cc">→ e-posta</a>
      </div>
    </Prompt>

    <Prompt cmd="cat ~/.profile" path="~" delay={1.1}>
      <p>
        Özgür yazılım ve özgür internet taraftarıyım. En çok yaptığım şey:
        bir kutuyu kırpıp <strong>engellerin etrafından dolaşmak</strong>.
      </p>
      <p>
        Gündüz ağ katmanında, gece komut satırında. <strong>Açık kaynak</strong>,
        denetlenebilir ve kayıt tutmayan araçlar üretmeye çalışıyorum.
      </p>
    </Prompt>
  </Terminal>

  <!-- ===== projeler ===== -->
  <p class="section-title">$ ls ~/projects</p>
  <Terminal title="~/projects — ls -la">
    <div class="projects">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <div class="btn-row">
      <a class="btn btn--ghost" href="/projects">→ tüm projeler ({projects.length})</a>
    </div>
  </Terminal>

  <!-- ===== blog ===== -->
  <p class="section-title">$ ls -lt ~/blog | head</p>
  <Terminal title="~/blog — less">
    {
      posts.length > 0 ? (
        <ul class="posts">
          {posts.map((p) => (
            <PostItem post={p} />
          ))}
        </ul>
      ) : (
        <p class="notice">henüz yazı yok — yakında.</p>
      )
    }
    <div class="btn-row">
      <a class="btn btn--ghost" href="/blog">→ tüm yazılar</a>
    </div>
  </Terminal>

  <!-- ===== iletişim ===== -->
  <p class="section-title">$ ./contact</p>
  <Terminal title="contact — ./run">
    <p class="out" style="margin-bottom: 0">
      <span class="dim">#</span> en hızlı yol e-posta:
      <a href="mailto:omer@mustundag.cc">omer@mustundag.cc</a>
      <br />
      <span class="dim">#</span> geri kalanı:
      <a href="https://github.com/omerustundag58">github.com/omerustundag58</a>
      · <a href="/rss.xml">rss</a>
    </p>
    <p class="out" style="margin-top: 14px; margin-bottom: 0">
      <span class="prompt">omer@mustundag:~$</span>
      <span class="dim"> logout</span><span class="cursor-blink" aria-hidden="true">▌</span>
    </p>
  </Terminal>
</Base>
